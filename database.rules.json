{
  "rules": {
    "rooms": {
      "$code": {
        "meta": {
          ".read": "auth != null",
          ".write": "auth != null && ((!data.exists() && newData.child('moderatorId').val() === auth.uid) || data.child('moderatorId').val() === auth.uid)",
          "moderatorId": { ".validate": "newData.isString()" },
          "status": {
            ".validate": "newData.isString() && (newData.val() === 'lobby' || newData.val() === 'configuring' || newData.val() === 'dealing' || newData.val() === 'in_game' || newData.val() === 'ended')"
          },
          "createdAt": { ".validate": "newData.isNumber()" },
          "lastActivity": { ".validate": "newData.isNumber()" }
        },

        "config": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('rooms').child($code).child('meta').child('moderatorId').val() === auth.uid"
        },

        "players": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('rooms').child($code).child('meta').child('status').val() === 'lobby'",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 24" },
            "connected": { ".validate": "newData.isBoolean()" },
            "joinedAt": { ".validate": "newData.isNumber()" },
            "lastSeen": { ".validate": "newData.isNumber()" },
            "viewed": {
              ".write": "auth != null && root.child('rooms').child($code).child('meta').child('moderatorId').val() === auth.uid",
              ".validate": "newData.isBoolean()"
            },
            "alive": {
              ".write": "auth != null && root.child('rooms').child($code).child('meta').child('moderatorId').val() === auth.uid",
              ".validate": "newData.isBoolean() && root.child('rooms').child($code).child('meta').child('moderatorId').val() === auth.uid"
            }
          }
        },

        "chat": {
          ".read": "auth != null && (root.child('rooms').child($code).child('players').child(auth.uid).exists() || root.child('rooms').child($code).child('meta').child('moderatorId').val() === auth.uid)",
          ".write": "auth != null && root.child('rooms').child($code).child('meta').child('moderatorId').val() === auth.uid",
          "$msgId": {
            ".write": "auth != null && !data.exists() && newData.child('uid').val() === auth.uid && (root.child('rooms').child($code).child('players').child(auth.uid).exists() || root.child('rooms').child($code).child('meta').child('moderatorId').val() === auth.uid)",
            ".validate": "newData.hasChildren(['uid','name','text','ts']) && newData.child('uid').val() === auth.uid && newData.child('name').isString() && newData.child('name').val().length <= 24 && newData.child('text').isString() && newData.child('text').val().length >= 1 && newData.child('text').val().length <= 300 && newData.child('ts').isNumber()"
          }
        },

        "mafiaChat": {
          ".read": "auth != null && root.child('rooms').child($code).child('privateRoles').child(auth.uid).child('role').val() === 'Mafia' && root.child('rooms').child($code).child('players').child(auth.uid).child('alive').val() === true",
          ".write": "auth != null && root.child('rooms').child($code).child('meta').child('moderatorId').val() === auth.uid",
          "$msgId": {
            ".write": "auth != null && !data.exists() && newData.child('uid').val() === auth.uid && root.child('rooms').child($code).child('privateRoles').child(auth.uid).child('role').val() === 'Mafia' && root.child('rooms').child($code).child('players').child(auth.uid).child('alive').val() === true && root.child('rooms').child($code).child('game').child('phase').val() === 'night'",
            ".validate": "newData.hasChildren(['uid','name','text','ts']) && newData.child('uid').val() === auth.uid && newData.child('name').isString() && newData.child('name').val().length <= 24 && newData.child('text').isString() && newData.child('text').val().length >= 1 && newData.child('text').val().length <= 300 && newData.child('ts').isNumber()"
          }
        },

        "dayChat": {
          ".read": "auth != null && (root.child('rooms').child($code).child('players').child(auth.uid).exists() || root.child('rooms').child($code).child('meta').child('moderatorId').val() === auth.uid)",
          ".write": "auth != null && root.child('rooms').child($code).child('meta').child('moderatorId').val() === auth.uid",
          "$msgId": {
            ".write": "auth != null && !data.exists() && newData.child('uid').val() === auth.uid && root.child('rooms').child($code).child('players').child(auth.uid).child('alive').val() === true && root.child('rooms').child($code).child('game').child('phase').val() === 'day'",
            ".validate": "newData.hasChildren(['uid','name','text','ts']) && newData.child('uid').val() === auth.uid && newData.child('name').isString() && newData.child('name').val().length <= 24 && newData.child('text').isString() && newData.child('text').val().length >= 1 && newData.child('text').val().length <= 300 && newData.child('ts').isNumber()"
          }
        },

        "privateRoles": {
          ".read": "auth != null && root.child('rooms').child($code).child('meta').child('moderatorId').val() === auth.uid",
          ".write": "auth != null && root.child('rooms').child($code).child('meta').child('moderatorId').val() === auth.uid",
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['role']) && newData.child('role').isString()"
          }
        },

        "game": {
          ".read": "auth != null && (root.child('rooms').child($code).child('players').child(auth.uid).exists() || root.child('rooms').child($code).child('meta').child('moderatorId').val() === auth.uid)",
          ".write": "auth != null && root.child('rooms').child($code).child('meta').child('moderatorId').val() === auth.uid",
          "phase": { ".validate": "newData.isString() && (newData.val() === 'night' || newData.val() === 'day' || newData.val() === 'ended')" },
          "round": { ".validate": "newData.isNumber()" },
          "winner": { ".validate": "newData.val() === 'town' || newData.val() === 'mafia'" }
        },

        "mafiaTeam": {
          ".write": "auth != null && root.child('rooms').child($code).child('meta').child('moderatorId').val() === auth.uid",
          "$uid": {
            ".read": "auth != null && auth.uid === $uid"
          }
        },

        "publicRoles": {
          ".read": "auth != null && (root.child('rooms').child($code).child('players').child(auth.uid).exists() || root.child('rooms').child($code).child('meta').child('moderatorId').val() === auth.uid)",
          ".write": "auth != null && root.child('rooms').child($code).child('meta').child('moderatorId').val() === auth.uid && (!newData.exists() || root.child('rooms').child($code).child('game').child('phase').val() === 'ended')",
          "$uid": {
            ".validate": "newData.isString()"
          }
        },

        "rounds": {
          ".write": "auth != null && root.child('rooms').child($code).child('meta').child('moderatorId').val() === auth.uid",
          "$n": {
            "nightActions": {
              ".read": "auth != null && root.child('rooms').child($code).child('meta').child('moderatorId').val() === auth.uid",
              "$uid": {
                ".read": "auth != null && (auth.uid === $uid || (data.child('role').val() === 'Mafia' && root.child('rooms').child($code).child('privateRoles').child(auth.uid).child('role').val() === 'Mafia' && root.child('rooms').child($code).child('players').child(auth.uid).child('alive').val() === true))",
                ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($code).child('players').child(auth.uid).child('alive').val() === true && root.child('rooms').child($code).child('game').child('phase').val() === 'night'",
                ".validate": "newData.hasChildren(['role','action','targetUid']) && newData.child('role').isString() && (newData.child('action').val() === 'kill' || newData.child('action').val() === 'protect' || newData.child('action').val() === 'investigate') && newData.child('targetUid').isString()"
              }
            },

            "nightResults": {
              ".write": "auth != null && root.child('rooms').child($code).child('meta').child('moderatorId').val() === auth.uid",
              "$uid": {
                ".read": "auth != null && auth.uid === $uid",
                ".validate": "newData.hasChildren(['result']) && (newData.child('result').val() === 'mafia' || newData.child('result').val() === 'not-mafia')"
              }
            },

            "nightOutcome": {
              ".read": "auth != null && (root.child('rooms').child($code).child('players').child(auth.uid).exists() || root.child('rooms').child($code).child('meta').child('moderatorId').val() === auth.uid)",
              ".write": "auth != null && root.child('rooms').child($code).child('meta').child('moderatorId').val() === auth.uid",
              ".validate": "newData.hasChildren(['resolvedAt']) && newData.child('resolvedAt').isNumber()",
              "eliminatedUid": { ".validate": "newData.isString()" }
            },

            "votes": {
              ".read": "auth != null && (root.child('rooms').child($code).child('players').child(auth.uid).exists() || root.child('rooms').child($code).child('meta').child('moderatorId').val() === auth.uid)",
              "$uid": {
                ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($code).child('players').child(auth.uid).child('alive').val() === true && root.child('rooms').child($code).child('game').child('phase').val() === 'day'",
                ".validate": "newData.hasChildren(['targetUid','votedAt']) && newData.child('targetUid').isString() && newData.child('votedAt').isNumber()"
              }
            },

            "dayOutcome": {
              ".read": "auth != null && (root.child('rooms').child($code).child('players').child(auth.uid).exists() || root.child('rooms').child($code).child('meta').child('moderatorId').val() === auth.uid)",
              ".write": "auth != null && root.child('rooms').child($code).child('meta').child('moderatorId').val() === auth.uid",
              ".validate": "newData.hasChildren(['resolvedAt']) && newData.child('resolvedAt').isNumber()",
              "eliminatedUid": { ".validate": "newData.isString()" }
            }
          }
        }
      }
    }
  }
}
