# Firebase web config for Mafia Wars (Phase 2). COMMITTED placeholder — no real values.
# Copy this file to `.env.local` and fill it in. `.env.local` is gitignored (stays private).
# These NEXT_PUBLIC_* values are public by design (they ship to the browser); security
# comes from Firebase Auth + Security Rules, not from hiding them. Never put a
# service-account key here.

# --- Local development against the Emulator Suite (recommended) ---
# Set to "true" to use the local emulators (no real Firebase credentials needed).
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true

# For emulator-only dev you can use a demo project id (prefix "demo-") with any
# placeholder api key. For production, paste the real values from the Firebase Console
# (Project settings → General → Your apps → SDK setup and configuration).
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id
